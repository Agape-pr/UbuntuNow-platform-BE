# Copy to .env (never commit .env). Values shown here are placeholders.

# --- shared by EVERY Python service: must be identical on all of them ---
DJANGO_SECRET_KEY=change-me-long-random-string
INTERNAL_SERVICE_TOKEN=change-me-another-long-random-string

# --- local database / broker (docker compose) ---
POSTGRES_PASSWORD=password

# --- email (auth-service) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@ubuntunow.rw
RESEND_FROM_NAME=UbuntuNow
RESEND_TEMPLATE_ID=

# --- media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- payments (payment-service) ---
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
INTOUCH_ENV=sandbox
INTOUCH_USERNAME=
INTOUCH_ACCOUNT_NO=
INTOUCH_PARTNER_PASSWORD=
# Recommended before going live: random secret added to the IntouchPay callback URL (?token=...)
INTOUCH_WEBHOOK_SECRET=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- one-time admin bootstrap (auth-service) ---
ADMIN_SETUP_SECRET=
